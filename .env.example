# Local development only. This file is not loaded automatically by the app.
NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/wagering_db
# Local fallback options, used only when DATABASE_URL is empty in development/test.
# POSTGRES_DB=wagering_db
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5433
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

POSTGRES_SSL=false
# POSTGRES_SSL_CA_FILE=
POSTGRES_POOL_MIN=0
POSTGRES_POOL_MAX=10
POSTGRES_POOL_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECTION_TIMEOUT_MS=5000
POSTGRES_QUERY_TIMEOUT_MS=30000
POSTGRES_STATEMENT_TIMEOUT_MS=30000
POSTGRES_LOCK_TIMEOUT_MS=5000

SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WORKERS_ENABLED=true
SQS_QUEUES_AUTO_CREATE=true
SQS_WAGER_QUEUE_NAME=wager-transactions.fifo
SQS_WAGER_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENT_QUEUE_NAME=wagering-events
SQS_WAGER_VISIBILITY_TIMEOUT_SECONDS=45
SQS_WORKER_SHUTDOWN_TIMEOUT_MS=25000
